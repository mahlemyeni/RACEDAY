<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <!-- Changed to dark theme for a more sporting/energetic look -->
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-uppercase" style="font-style: italic; letter-spacing: 1px;" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="text-warning">Race</span>Day
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        @if (User.IsInRole("Admin") || User.IsInRole("Organiser"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="UserRoles" asp-action="Index">Manage Users</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Events" asp-action="Index">Events</a>
                            </li>
                        }
                        else if (User.IsInRole("Participant"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Enrolments" asp-action="My">Enrolments</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Enrolments" asp-action="Create">Signup</a>
                            </li>
                        }
                    </ul>
                    <!-- _LoginPartial is rendered here -->
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <!-- Added flex-grow-1 to push footer to bottom -->
    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted bg-white border-top py-3 mt-auto">
        <div class="container text-center">
            &copy; 2026 - <span class="fw-bold"><span class="text-warning">Race</span>Day</span> - <a class="text-decoration-none" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>