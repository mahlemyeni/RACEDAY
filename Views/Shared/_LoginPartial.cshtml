@using Microsoft.AspNetCore.Identity
@using RaceDay.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        var displayName = user?.FirstName ?? User.Identity?.Name;
        // Safely get the first letter of the name, fallback to "U" for User
        var initial = string.IsNullOrEmpty(displayName) ? "U" : displayName.Substring(0, 1).ToUpper();

        <li class="nav-item d-flex align-items-center">
            <a class="nav-link text-light d-flex align-items-center gap-2" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                @if (!string.IsNullOrEmpty(user?.ProfileImagePath))
                {
                    <!-- If they have a real profile image, show it -->
                    <img src="@user.ProfileImagePath" class="rounded-circle border border-warning" width="32" height="32" style="object-fit:cover" alt="Profile" />
                }
                else
                {
                    <!-- If no image, show the snazzy RaceDay initial avatar -->
                    <div class="rounded-circle bg-warning text-dark d-flex justify-content-center align-items-center fw-bold shadow-sm"
                         style="width: 35px; height: 35px; font-size: 1.1rem;">
                        @initial
                    </div>
                }
                <span>Hello @displayName!</span>
            </a>
        </li>

        <li class="nav-item d-flex align-items-center">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link text-light border-0">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-light" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-light" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    }
</ul>